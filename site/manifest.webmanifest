{
  "name": "Liberia Assistance data viewer",
  "short_name": "Liberia Assistance",
  "description": "Unofficial viewer of aid received by Liberia from all donors (OECD and IATI data).",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f5f0",
  "theme_color": "#0e2a5c",
  "icons": [
    { "src": "icons/icon-192.png?v=1", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png?v=1", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png?v=1", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg?v=1", "sizes": "any", "type": "image/svg+xml" }
  ]
}
